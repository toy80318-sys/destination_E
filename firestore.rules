rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 세이브: 본인 데이터만 읽기/쓰기 가능
    match /saves/{uid}/slots/{slotId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // 이메일 기반 간편 세이브 — 익명 로그인 상태에서만 접근
    // (이메일 = 식별자, 패스워드 없음 — 캐주얼 게임용 간편 모드)
    // 형식 검증: 이메일에 @가 있고 100자 이내
    match /email_saves/{email}/slots/{slotId} {
      allow read, write: if request.auth != null
        && email.matches('.*@.*\\..*')
        && email.size() <= 100;
    }

    // 피드백: 누구나 쓰기 가능 (익명 사용자 포함), 관리자만 읽기
    match /feedback/{docId} {
      allow create: if request.auth != null
        && request.resource.data.msg is string
        && request.resource.data.msg.size() > 0
        && request.resource.data.msg.size() <= 500;
      allow read: if request.auth != null
        && request.auth.token.email == 'toy80318@gmail.com';
      allow update, delete: if request.auth != null
        && request.auth.token.email == 'toy80318@gmail.com';
    }

    // 🏆 명예의 전당 (글로벌 리더보드) — 누구나 조회, 본인 uid 로만 작성
    //  · ACT4(지구 해방)·ACT5(보이드의 심연) 클리어 시 자동 업로드
    //  · 조작/삭제는 관리자만 가능
    match /hall_of_fame/{docId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.act is int
        && request.resource.data.act >= 4
        && request.resource.data.act <= 5
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 20;
      allow update, delete: if request.auth != null
        && request.auth.token.email == 'toy80318@gmail.com';
    }

    // 그 외 모든 경로는 차단
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
