{
  "name": "destination-earth",
  "version": "1.1.0",
  "description": "DESTINATION EARTH — 빅 픽처 스페이스 RPG",
  "author": "toy80318",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "electron": "electron .",
    "electron:dev": "electron . --enable-logging",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux",
    "deploy": "firebase deploy --only hosting --project cgstation-d8178 --non-interactive && npm run cleanup",
    "deploy:full": "firebase deploy --project cgstation-d8178 --non-interactive && npm run cleanup",
    "cleanup": "node scripts/firebase-cleanup.js 5",
    "cleanup:aggressive": "node scripts/firebase-cleanup.js 3"
  },
  "dependencies": {
    "puppeteer-core": "^25.0.4"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "kr.cgtation.destinationearth",
    "productName": "Destination Earth",
    "copyright": "Copyright © 2026 toy80318",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "index.html",
      "game.js",
      "game.css",
      "manifest.json",
      "js/**/*",
      "img/**/*",
      "!img_backup/**",
      "!.screens/**",
      "!Doc/**",
      "!**/*.map",
      "!service-worker.js"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "img/icons/icon-512.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Destination Earth",
      "language": "1042"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.games",
      "icon": "img/icons/icon-512.png"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Game",
      "icon": "img/icons/icon-512.png"
    }
  }
}
