[{"out": "clips_en/commander_f/commander_f_001.mp3", "voice": "Xb7hH8MSUJpSbSDYk0k2", "model": "eleven_v3", "stability": 0.0, "text": "[resolute][hesitant][curious] ...How long was I out?"}, {"out": "clips_en/commander_f/commander_f_002.mp3", "voice": "Xb7hH8MSUJpSbSDYk0k2", "model": "eleven_v3", "stability": 0.0, "text": "[resolute][hesitant][curious] And Earth... still?"}, {"out": "clips_en/commander_f/commander_f_003.mp3", "voice": "Xb7hH8MSUJpSbSDYk0k2", "model": "eleven_v3", "stability": 0.0, "text": "[resolute][hesitant] ...So home is still up there."}, {"out": "clips_en/commander_f/commander_f_004.mp3", "voice": "Xb7hH8MSUJpSbSDYk0k2", "model": "eleven_v3", "stability": 0.0, "text": "[resolute][hesitant][curious] …People? Someone's still out here?"}, {"out": "clips_en/commander_f/commander_f_005.mp3", "voice": "Xb7hH8MSUJpSbSDYk0k2", "model": "eleven_v3", "stability": 0.0, "text": "[resolute][curious] You mean to break a blockade with trade?"}, {"out": "clips_en/commander_f/commander_f_006.mp3", "voice": "Xb7hH8MSUJpSbSDYk0k2", "model": "eleven_v3", "stability": 0.0, "text": "[resolute] I was asleep a long while. Only just woke."}, {"out": "clips_en/commander_f/commander_f_007.mp3", "voice": "Xb7hH8MSUJpSbSDYk0k2", "model": "eleven_v3", "stability": 0.0, "text": "[resolute] Scrap, for now. But soon — I'll bring back something far bigger."}, {"out": "clips_en/commander_f/commander_f_008.mp3", "voice": "Xb7hH8MSUJpSbSDYk0k2", "model": "eleven_v3", "stability": 0.0, "text": "[resolute][hesitant][curious] Geobukseon"}, {"out": "clips_en/commander_f/commander_f_009.mp3", "voice": "Xb7hH8MSUJpSbSDYk0k2", "model": "eleven_v3", "stability": 0.0, "text": "[resolute][hesitant][curious] That person — where are they now?"}, {"out": "clips_en/commander_f/commander_f_010.mp3", "voice": "Xb7hH8MSUJpSbSDYk0k2", "model": "eleven_v3", "stability": 0.0, "text": "[resolute] I'm counting on you."}, {"out": "clips_en/commander_f/commander_f_011.mp3", "voice": "Xb7hH8MSUJpSbSDYk0k2", "model": "eleven_v3", "stability": 0.0, "text": "[resolute] We save them."}, {"out": "clips_en/commander_f/commander_f_012.mp3", "voice": "Xb7hH8MSUJpSbSDYk0k2", "model": "eleven_v3", "stability": 0.0, "text": "[resolute] Here we go."}, {"out": "clips_en/commander_f/commander_f_013.mp3", "voice": "Xb7hH8MSUJpSbSDYk0k2", "model": "eleven_v3", "stability": 0.0, "text": "[resolute] So we meet Krieg already, here."}, {"out": "clips_en/commander_f/commander_f_014.mp3", "voice": "Xb7hH8MSUJpSbSDYk0k2", "model": "eleven_v3", "stability": 0.0, "text": "[resolute][hesitant] …We get the people out first."}, {"out": "clips_en/commander_f/commander_f_015.mp3", "voice": "Xb7hH8MSUJpSbSDYk0k2", "model": "eleven_v3", "stability": 0.0, "text": "[resolute] Baekgu, 62% is enough."}, {"out": "clips_en/commander_f/commander_f_016.mp3", "voice": "Xb7hH8MSUJpSbSDYk0k2", "model": "eleven_v3", "stability": 0.0, "text": "[resolute] Marco Polo. They say he's an independent broker in this sector. A smuggler who slips past Chiks eyes — he'll have the comms gear we need."}, {"out": "clips_en/commander_f/commander_f_017.mp3", "voice": "Xb7hH8MSUJpSbSDYk0k2", "model": "eleven_v3", "stability": 0.0, "text": "[resolute] This is a galactic public lane. Move."}, {"out": "clips_en/commander_f/commander_f_018.mp3", "voice": "Xb7hH8MSUJpSbSDYk0k2", "model": "eleven_v3", "stability": 0.0, "text": "[resolute] We dig it out. All the more if something's alive in there."}, {"out": "clips_en/commander_f/commander_f_019.mp3", "voice": "Xb7hH8MSUJpSbSDYk0k2", "model": "eleven_v3", "stability": 0.0, "text": "[resolute] Catch Ork and the next route opens up. We move out."}, {"out": "clips_en/commander_f/commander_f_020.mp3", "voice": "Xb7hH8MSUJpSbSDYk0k2", "model": "eleven_v3", "stability": 0.0, "text": "[resolute] We've got three Chiks mutant spores — cargo from this very sector. Let's use them as our cover."}, {"out": "clips_en/commander_f/commander_f_021.mp3", "voice": "Xb7hH8MSUJpSbSDYk0k2", "model": "eleven_v3", "stability": 0.0, "text": "[resolute][hesitant] We destroy the blueprints. And we pull Tesla out alive. (quietly) …People first."}, {"out": "clips_en/commander_f/commander_f_022.mp3", "voice": "Xb7hH8MSUJpSbSDYk0k2", "model": "eleven_v3", "stability": 0.0, "text": "[resolute][curious] The route into the underground prison — Marco, can you pull up a map of the sector?"}, {"out": "clips_en/commander_f/commander_f_023.mp3", "voice": "Xb7hH8MSUJpSbSDYk0k2", "model": "eleven_v3", "stability": 0.0, "text": "[resolute] General Yi Sun-sin has been locked in there for centuries. Today, we end it."}, {"out": "clips_en/commander_f/commander_f_024.mp3", "voice": "Xb7hH8MSUJpSbSDYk0k2", "model": "eleven_v3", "stability": 0.0, "text": "[resolute] Admiral. Let's go together."}, {"out": "clips_en/commander_f/commander_f_025.mp3", "voice": "Xb7hH8MSUJpSbSDYk0k2", "model": "eleven_v3", "stability": 0.0, "text": "[resolute] Let's deal with it together."}, {"out": "clips_en/commander_f/commander_f_026.mp3", "voice": "Xb7hH8MSUJpSbSDYk0k2", "model": "eleven_v3", "stability": 0.0, "text": "[resolute] Analyzing the coordinates with the Aureus Information Chip. We're going in."}, {"out": "clips_en/commander_f/commander_f_027.mp3", "voice": "Xb7hH8MSUJpSbSDYk0k2", "model": "eleven_v3", "stability": 0.0, "text": "[resolute] Eisenklau. Enforcer of the hundred-year blockade. Today, I cut your chains right here."}, {"out": "clips_en/commander_f/commander_f_028.mp3", "voice": "Xb7hH8MSUJpSbSDYk0k2", "model": "eleven_v3", "stability": 0.0, "text": "[resolute] We're going in. Three Aureus Solar Cores, three Mechanica quantum chips — that's enough."}, {"out": "clips_en/commander_f/commander_f_029.mp3", "voice": "Xb7hH8MSUJpSbSDYk0k2", "model": "eleven_v3", "stability": 0.0, "text": "[resolute][hesitant] ... We're going in."}, {"out": "clips_en/commander_f/commander_f_030.mp3", "voice": "Xb7hH8MSUJpSbSDYk0k2", "model": "eleven_v3", "stability": 0.0, "text": "[resolute] All ships. Crane Wing Formation. Geobukseon at center. We're going in."}, {"out": "clips_en/commander_f/commander_f_031.mp3", "voice": "Xb7hH8MSUJpSbSDYk0k2", "model": "eleven_v3", "stability": 0.0, "text": "[resolute] Eisenklaue. The crime of caging humanity for a hundred years — ends today."}, {"out": "clips_en/commander_f/commander_f_032.mp3", "voice": "Xb7hH8MSUJpSbSDYk0k2", "model": "eleven_v3", "stability": 0.0, "text": "[resolute][hesitant] ... Fire."}, {"out": "clips_en/commander_f/commander_f_033.mp3", "voice": "Xb7hH8MSUJpSbSDYk0k2", "model": "eleven_v3", "stability": 0.0, "text": "[resolute][hesitant] ... Everyone. Fire."}, {"out": "clips_en/commander_f/commander_f_034.mp3", "voice": "Xb7hH8MSUJpSbSDYk0k2", "model": "eleven_v3", "stability": 0.0, "text": "[resolute][hesitant] ... Baekgu."}, {"out": "clips_en/commander_f/commander_f_035.mp3", "voice": "Xb7hH8MSUJpSbSDYk0k2", "model": "eleven_v3", "stability": 0.0, "text": "[resolute][hesitant] ... We're going down."}, {"out": "clips_en/commander_f/commander_f_036.mp3", "voice": "Xb7hH8MSUJpSbSDYk0k2", "model": "eleven_v3", "stability": 0.0, "text": "[resolute][hesitant] ... Anywhere. We go together."}, {"out": "clips_en/commander_f/commander_f_037.mp3", "voice": "Xb7hH8MSUJpSbSDYk0k2", "model": "eleven_v3", "stability": 0.0, "text": "[resolute] Admiral Yi Sun-sin."}, {"out": "clips_en/commander_f/commander_f_038.mp3", "voice": "Xb7hH8MSUJpSbSDYk0k2", "model": "eleven_v3", "stability": 0.0, "text": "[resolute] The blockade still holds."}, {"out": "clips_en/commander_f/commander_f_039.mp3", "voice": "Xb7hH8MSUJpSbSDYk0k2", "model": "eleven_v3", "stability": 0.0, "text": "[resolute] Yes. A hundred years have passed."}, {"out": "clips_en/commander_f/commander_f_040.mp3", "voice": "Xb7hH8MSUJpSbSDYk0k2", "model": "eleven_v3", "stability": 0.0, "text": "[resolute][hesitant][curious] You're...?"}, {"out": "clips_en/commander_f/commander_f_041.mp3", "voice": "Xb7hH8MSUJpSbSDYk0k2", "model": "eleven_v3", "stability": 0.0, "text": "[resolute] Found it. I have one of the blueprints."}, {"out": "clips_en/commander_f/commander_f_042.mp3", "voice": "Xb7hH8MSUJpSbSDYk0k2", "model": "eleven_v3", "stability": 0.0, "text": "[resolute][curious] You expected this?"}, {"out": "clips_en/commander_f/commander_f_043.mp3", "voice": "Xb7hH8MSUJpSbSDYk0k2", "model": "eleven_v3", "stability": 0.0, "text": "[resolute] Gwanggaeto the Great"}]